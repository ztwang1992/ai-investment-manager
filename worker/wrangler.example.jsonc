// The quotes and exchange-rate relay Worker. Bound only to its own domain; workers.dev and preview URLs are off.
// Copy this file to worker/wrangler.jsonc (ignored by git) and fill in your own values: the routes domain,
// the kv_namespaces id, and APP_ORIGIN and SUPABASE_URL in vars (see docs/worker-setup.md).
{
	"name": "invest-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "api.example.com",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "QUOTES",
			"id": "your-kv-namespace-id"
		}
	],
	// Daily snapshots: the previous day's at 06:00 Beijing time, a rerun at 07:00
	"triggers": {
		"crons": ["0 22 * * *", "0 23 * * *"]
	},
	// APP_ORIGIN: the front-end addresses allowed to read quotes cross-origin, separated by commas (development pages on this machine and the LAN are always allowed).
	// SUPABASE_URL: the Supabase project URL (the front end exposes it anyway). Store the secret key with wrangler secret put SUPABASE_SECRET_KEY, not here
	"vars": {
		"APP_ORIGIN": "https://app.example.com",
		"SUPABASE_URL": "https://your-project.supabase.co"
	}
}